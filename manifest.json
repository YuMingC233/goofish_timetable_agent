{
  "manifest_version": 3,
  "name": "Goofish Timetable Agent",
  "version": "0.1.0",
  "description": "AI-powered auto-scheduling and Notion calendar sync for Xianyu sellers",
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Goofish Timetable Agent"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.goofish.com/*", "*://*.taobao.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.notion.com/*"
  ]
}
